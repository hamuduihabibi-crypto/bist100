# ---------------------------------------------------------------------------
# BIST Trading Bot — Ortam Değişkenleri (bu dosyayı .env olarak kopyalayın)
# ---------------------------------------------------------------------------

# Telegram Bot Token (BotFather'dan @BotFather -> /newbot)
# Boş bırakılırsa yalnızca Flask web sunucusu çalışır, bot devre dışıdır.
TELEGRAM_BOT_TOKEN=

# Web sunucusunun dinleyeceği port (Render/Heroku otomatik atar)
PORT=5000

# Sunucunun bağlanacağı adres (production'da 0.0.0.0 bırakın)
HOST=0.0.0.0

# Flask debug (yalnızca geliştirme): "1" açık, "0" kapalı
FLASK_DEBUG=0